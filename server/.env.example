# ===========================================
# BOOKMYCOOK Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# SECURITY KEYS (REQUIRED)
# ===========================================
# Generate strong random keys (min 32 characters)
# Use: python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=your-secret-key-here-min-32-characters-long
JWT_SECRET_KEY=your-jwt-secret-key-here-min-32-characters-long

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# SQLite (Development)
DATABASE_URL=sqlite:///bookmycook.db

# PostgreSQL (Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/bookmycook

# ===========================================
# RATE LIMITING
# ===========================================
# Storage backend for rate limiting
# Memory (Development)
RATE_LIMIT_STORAGE_URL=memory://

# Redis (Production)
# RATE_LIMIT_STORAGE_URL=redis://localhost:6379/0

# ===========================================
# TWO-FACTOR AUTHENTICATION
# ===========================================
OTP_ISSUER=BOOKMYCOOK

# ===========================================
# ADMIN SECURITY
# ===========================================
# Comma-separated list of allowed IPs for admin access
# Leave empty to allow all IPs (not recommended for production)
ADMIN_ALLOWED_IPS=127.0.0.1,::1

# ===========================================
# ENCRYPTION
# ===========================================
# Key for encrypting sensitive data at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# SESSION CONFIGURATION
# ===========================================
# Session lifetime in seconds (default: 24 hours)
SESSION_LIFETIME=86400

# Maximum concurrent sessions per user
MAX_CONCURRENT_SESSIONS=5

# ===========================================
# ACCOUNT LOCKOUT
# ===========================================
# Failed attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Lockout duration in minutes
LOCKOUT_DURATION_MINUTES=15

# ===========================================
# PASSWORD POLICY
# ===========================================
# Minimum password length
PASSWORD_MIN_LENGTH=8

# Require uppercase letters (true/false)
PASSWORD_REQUIRE_UPPERCASE=true

# Require lowercase letters (true/false)
PASSWORD_REQUIRE_LOWERCASE=true

# Require numbers (true/false)
PASSWORD_REQUIRE_NUMBERS=true

# Require special characters (true/false)
PASSWORD_REQUIRE_SPECIAL=true

# ===========================================
# AUDIT LOGGING
# ===========================================
# Enable audit logging (true/false)
AUDIT_LOGGING_ENABLED=true

# Log retention days
AUDIT_LOG_RETENTION_DAYS=90

# ===========================================
# SSL/TLS CONFIGURATION (Production)
# ===========================================
# Force HTTPS (true/false)
FORCE_HTTPS=true

# HSTS max age in seconds
HSTS_MAX_AGE=31536000

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@bookmycook.in
